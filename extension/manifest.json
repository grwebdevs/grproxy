{
  "manifest_version": 3,
  "name": "GRPROXY — High-Speed Cloudflare Edge & Telegram Proxy",
  "version": "1.1.0",
  "description": "Ultra-fast anti-censorship proxy with 100+ Cloudflare Anycast countries, verified SOCKS5, and zero-speed-loss split routing.",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "unlimitedStorage",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GRPROXY: Disconnected (Click to Connect)",
    "default_icon": {
      "16": "icons/icon-inactive-16.png",
      "32": "icons/icon-inactive-32.png",
      "48": "icons/icon-inactive-48.png",
      "128": "icons/icon-inactive-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-active-16.png",
    "32": "icons/icon-active-32.png",
    "48": "icons/icon-active-48.png",
    "128": "icons/icon-active-128.png"
  },
  "commands": {
    "toggle-proxy": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle GRPROXY Connection"
    }
  }
}
